FROM oven/bun:1

WORKDIR /app

COPY package*.json ./

RUN bun install

COPY . /app

ARG PORT
ARG DATABASE
ARG USER_DB
ARG PASSWORD
ARG HOST
ARG JWT_SECRET
ARG NODE_ENV

ENV PORT=${PORT}
ENV DATABASE=${DATABASE}
ENV USER_DB=${USER_DB}
ENV PASSWORD=${PASSWORD}
ENV HOST=${HOST}
ENV JWT_SECRET=${JWT_SECRET}
ENV NODE_ENV=${NODE_ENV}


CMD ["bun", "run", "index.ts"]